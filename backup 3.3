class Player_movement:
    def __init__(self, player, player_num):

        if player == "Ronaldo":
            self.image= Ronaldo_frames[0]
            self.frames = Ronaldo_frames.copy()
        if player == "Messi":
            self.image= Messi_frames[0]
            self.frames = Messi_frames.copy()
        if player == "Mbappe":
            self.image= Mbappe_frames[0]
            self.frames = Mbappe_frames.copy()

        if player_num == 1:
            start_x, start_y = 1200, 600
        if player_num == 2:
            start_x, start_y = 300, 600
            for index in range(len(self.frames)):
                self.frames[index] = pygame.transform.flip(self.frames[index], 1, 0)
            self.image = self.frames[0]


        self.rect = self.image.get_rect(center=(start_x, start_y))
        self.left_key, self.right_key = False, False
        self.velocity = 0
        self.gravity = 0.4
        self.ground = False
        self.friction = -0.045
        self.position = pygame.math.Vector2(start_x, start_y)
        self.velocity = pygame.math.Vector2(0, 0)
        self.acceleration = pygame.math.Vector2(0, self.gravity)

        #kick constants
        self.kicking = False
        self.frame_index = 0
        #self.frames = Ronaldo_frames
        self.last_kick = 0


    def horizontal(self):
        self.acceleration.x = 0
        if self.left_key == True:
            self.acceleration.x -= 0.85
        elif self.right_key == True:
            self.acceleration.x += 0.85
        self.acceleration.x += self.velocity.x * self.friction
        self.velocity.x += self.acceleration.x
        self.limit_velocity(13)
        self.position.x += self.velocity.x - (self.acceleration.x * .5)
        self.rect.x = self.position.x


    def vertical(self):
        if self.velocity.y + self.acceleration.y <= 12:
            self.velocity.y += self.acceleration.y
        self.position.y += self.velocity.y - (self.acceleration.y * .5)
        if self.position.y > 600:
            self.ground = True
            self.velocity.y = 0
            self.position.y = 600
        self.rect.bottom = self.position.y

    def jump(self):
        if self.ground == True:
            self.velocity.y -= 12
            self.ground = False


    def limit_velocity(self, max_vel):
        self.velocity.x = max(-max_vel, min(self.velocity.x, max_vel))
        if abs(self.velocity.x) < .01:
            self.velocity.x = 0


    def first_kick(self):
        if self.kicking != True:
            self.kicking = True
            self.frame_index = 0
            self.last_kick = pygame.time.get_ticks()
            self.image = self.frames[self.frame_index]

    def is_kicking(self):
        if self.kicking != True:
            return
        current_time = pygame.time.get_ticks()
        if current_time - self.last_kick >= 60:
            self.last_kick = current_time
            self.frame_index += 1

        if self.frame_index >= len(self.frames):
            self.frame_index = 0
            self.kicking = False
            self.image = self.frames[self.frame_index]
        else:
            self.image = self.frames[self.frame_index]




    def update(self):
        self.horizontal()
        self.vertical()
        self.is_kicking()



    def draw(self, screen):
        screen.blit(self.image, (self.rect.x, self.rect.y))



def game_loop():

    player1 = Player_movement(char_list[0], 1)
    player2 = Player_movement(char_list[1], 2)



    running = True
    while running: #main program
        FramesPerSec.tick(FPS)
        screen.blit(background, (0,0))


        for event in pygame.event.get():
            if event.type == QUIT:
                running = False

            if event.type == pygame.KEYDOWN:

                # keybinds associated with movement up/down/left right
                key = pygame.key.get_pressed()
                if key[pygame.K_RIGHT]:
                    player1.right_key = True

                if key[pygame.K_LEFT]:
                    player1.left_key = True

                if key[pygame.K_SPACE]:
                    player1.jump()

                if key[pygame.K_UP]:
                    player1.first_kick()

                key = pygame.key.get_pressed()
                if key[pygame.K_d]:
                    player2.right_key = True

                if key[pygame.K_a]:
                    player2.left_key = True

                if key[pygame.K_1]:
                    player2.jump()

                if key[pygame.K_w]:
                    player2.first_kick()


            if event.type == pygame.KEYUP:
                if event.key == pygame.K_RIGHT:
                    player1.right_key = False
                if event.key == pygame.K_LEFT:
                    player1.left_key = False


                if event.key == pygame.K_d:
                    player2.right_key = False
                if event.key == pygame.K_a:
                    player2.left_key = False


        player1.update()
        player1.draw(screen)
        player2.update()
        player2.draw(screen)
        pygame.display.update()





        # allows the user to quit the game
    pygame.quit()







