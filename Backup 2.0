def controls():
    screen.fill("black")

    # font constants
    text_font = pygame.font.SysFont('comicsans', 70)
    text_colour = (0, 0, 0)

    controls1_import = pygame.image.load("/Users/Pashwa/Desktop/Coursework/Controls - Single player.png").convert()
    controls1_image = pygame.transform.scale(controls1_import, (400, 400))
    screen.blit(controls1_image, (100,300))

    controls1_import = pygame.image.load("/Users/Pashwa/Desktop/Coursework/Controls - Two player.png").convert()
    controls1_image = pygame.transform.scale(controls1_import, (400, 400))
    screen.blit(controls1_image, (900,300))

    Home_text = text_font.render("Home", True, text_colour)
    Home_rect = Home_text.get_rect(center=(200, 150))
    HomeButton_rect = Home_rect.inflate(110, 70)
    pygame.draw.rect(screen, (0, 0, 128), HomeButton_rect, border_radius=10)
    screen.blit(Home_text, Home_rect)

    pygame.display.update()

    running =  True
    while running:


        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

            if event.type == pygame.MOUSEBUTTONDOWN:
                if HomeButton_rect.collidepoint(event.pos):
                    running = False
                    home()



