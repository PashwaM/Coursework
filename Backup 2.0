def gamemode(selected):
    # font constants
    text_font = pygame.font.SysFont('comicsans', 70)
    text_colour = (0, 0, 0)

    screen.fill("black")

    play_text = text_font.render("Play", True, text_colour)
    play_rect = play_text.get_rect(center=(750, 250))
    PlayButton_rect = play_rect.inflate(110, 70)
    pygame.draw.rect(screen, (0, 0, 128), PlayButton_rect, border_radius=10)
    screen.blit(play_text, play_rect)

    SinglePlayer_text = text_font.render("Single Player", True, text_colour)
    SinglePlayer_rect = SinglePlayer_text.get_rect(center=(750, 450))
    SinglePlayerbutton_rect = SinglePlayer_rect.inflate(110, 70)
    pygame.draw.rect(screen, (0, 0, 128), SinglePlayerbutton_rect, border_radius=10)
    pygame.draw.rect(screen, (255, 255, 255), SinglePlayerbutton_rect, 5, border_radius=10)
    screen.blit(SinglePlayer_text, SinglePlayer_rect)

    TwoPlayer_text = text_font.render("Two Player", True, text_colour)
    TwoPlayer_rect = TwoPlayer_text.get_rect(center=(750, 650))
    TwoPlayerbutton_rect = TwoPlayer_rect.inflate(110, 70)
    pygame.draw.rect(screen, (0, 0, 128), TwoPlayerbutton_rect, border_radius=10)
    screen.blit(TwoPlayer_text, TwoPlayer_rect)

    Controls_text = text_font.render("Controls", True, text_colour)
    Controls_rect = Controls_text.get_rect(center=(300, 180))
    ControlsButton_rect = Controls_rect.inflate(110, 70)
    pygame.draw.rect(screen, (0, 0, 128), ControlsButton_rect, border_radius=10)
    screen.blit(Controls_text, Controls_rect)

    Characters_text = text_font.render("Characters", True, text_colour)
    Characters_rect = Characters_text.get_rect(center=(1200, 180))
    CharactersButton_rect = Characters_rect.inflate(110, 70)
    pygame.draw.rect(screen, (0, 0, 128), CharactersButton_rect, border_radius=10)
    screen.blit(Characters_text, Characters_rect)

    if selected % 2 != 0:
        #unselects single player and selects two player
        pygame.draw.rect(screen, (0, 0, 128), SinglePlayerbutton_rect, border_radius=10)
        screen.blit(SinglePlayer_text, SinglePlayer_rect)

        pygame.draw.rect(screen, (0, 0, 128), TwoPlayerbutton_rect, border_radius=10)
        pygame.draw.rect(screen, (255, 255, 255), TwoPlayerbutton_rect, 5,  border_radius=10)
        screen.blit(TwoPlayer_text, TwoPlayer_rect)
    else:
        #selects single player and unselects two player
        pygame.draw.rect(screen, (0, 0, 128), SinglePlayerbutton_rect, border_radius=10)
        pygame.draw.rect(screen, (255, 255, 255), SinglePlayerbutton_rect, 5,  border_radius=10)
        screen.blit(SinglePlayer_text, SinglePlayer_rect)

        pygame.draw.rect(screen, (0, 0, 128), TwoPlayerbutton_rect,  border_radius=10)
        screen.blit(TwoPlayer_text, TwoPlayer_rect)


def home():
    # font constants
    text_font = pygame.font.SysFont('comicsans', 70)
    text_colour = (0, 0, 0)

    screen.fill("black")

    play_text = text_font.render("Play", True, text_colour)
    play_rect = play_text.get_rect(center=(750, 250))
    PlayButton_rect = play_rect.inflate(110, 70)

    SinglePlayer_text = text_font.render("Single Player", True, text_colour)
    SinglePlayer_rect = SinglePlayer_text.get_rect(center=(750, 450))
    SinglePlayerbutton_rect = SinglePlayer_rect.inflate(110, 70)


    TwoPlayer_text = text_font.render("Two Player", True, text_colour)
    TwoPlayer_rect = TwoPlayer_text.get_rect(center=(750, 650))
    TwoPlayerbutton_rect = TwoPlayer_rect.inflate(110, 70)


    Controls_text = text_font.render("Controls", True, text_colour)
    Controls_rect = Controls_text.get_rect(center=(300, 180))
    ControlsButton_rect = Controls_rect.inflate(110, 70)

    Characters_text = text_font.render("Characters", True, text_colour)
    Characters_rect = Characters_text.get_rect(center=(1200, 180))
    CharactersButton_rect = Characters_rect.inflate(110, 70)



    pygame.draw.rect(screen, (0, 0, 128), SinglePlayerbutton_rect, border_radius=10)
    pygame.draw.rect(screen, (255, 255, 255), SinglePlayerbutton_rect, 5, border_radius=10)
    screen.blit(SinglePlayer_text, SinglePlayer_rect)

    pygame.draw.rect(screen, (0, 0, 128), TwoPlayerbutton_rect, border_radius=10)
    screen.blit(TwoPlayer_text, TwoPlayer_rect)


    running = True
    selected = 0


    while running:
        pygame.display.update()

        pygame.draw.rect(screen, (0, 0, 128), PlayButton_rect, border_radius=10)
        screen.blit(play_text, play_rect)


        pygame.draw.rect(screen, (0, 0, 128), ControlsButton_rect, border_radius=10)
        screen.blit(Controls_text, Controls_rect)

        pygame.draw.rect(screen, (0, 0, 128), CharactersButton_rect, border_radius=10)
        screen.blit(Characters_text, Characters_rect)


        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False

            if event.type == pygame.MOUSEBUTTONDOWN:
                    if PlayButton_rect.collidepoint(event.pos):
                        running = False
                        game_loop()
                    if SinglePlayerbutton_rect.collidepoint(event.pos):
                        selected+=1
                        gamemode(selected)
                    if TwoPlayerbutton_rect.collidepoint(event.pos):
                        selected+=1
                        gamemode(selected)
                    if ControlsButton_rect.collidepoint(event.pos):
                        running = False
                        controls()
                    if CharactersButton_rect.collidepoint(event.pos):
                        running = False
                        characters()




class player_movement():
    def __init__(self):

        self.test_image=pygame.transform.scale(image_import, (150, 150))
        self.rect = self.test_image.get_rect(center=(200,600))
        self.left_key_pressed, self.right_key_pressed = False, False
        self.velocity = 0
        self.gravity = 0.4
        self.jumping, self.ground = False, False
        self.friction = -0.045
        self.position = pygame.math.Vector2(200, 600)
        self.velocity = pygame.math.Vector2(0, 0)
        self.acceleration = pygame.math.Vector2(0, self.gravity)

    def horizontal(self):
        self.acceleration.x = 0
        if self.left_key_pressed == True:
            self.acceleration.x -= 0.85
        elif self.right_key_pressed == True:
            self.acceleration.x += 0.85
        self.acceleration.x += self.velocity.x * self.friction
        self.velocity.x += self.acceleration.x
        self.limit_velocity(13)
        self.position.x += self.velocity.x - (self.acceleration.x * .5)
        self.rect.x = self.position.x

    def vertical(self):
        if self.velocity.y + self.acceleration.y <= 12:
            self.velocity.y += self.acceleration.y
        self.position.y += self.velocity.y - (self.acceleration.y * .5)
        if self.position.y > 600:
            self.ground = True
            self.velocity.y = 0
            self.position.y = 600
        self.rect.bottom = self.position.y

    def jump(self):
        if self.ground == True:
            self.jumping = False
            self.velocity.y -= 12
            self.ground = False



    def update(self):
        self.horizontal()
        self.vertical()


    def limit_velocity(self, max_vel):
        self.velocity.x = max(-max_vel, min(self.velocity.x, max_vel))
        if abs(self.velocity.x) < .01:
            self.velocity.x = 0


    def draw(self, screen):
        screen.blit(self.test_image, (self.rect.x, self.rect.y))



def game_loop():

    clock = pygame.time.Clock()
    test_image = player_movement()


    running = True
    while running: #main program
        clock.tick(60)
        screen.blit(background, (0,0))


        for event in pygame.event.get():
            if event.type == QUIT:
                running = False

            if event.type == pygame.KEYDOWN:

                # keybinds associated with movement up/down/left right
                key = pygame.key.get_pressed()
                if key[pygame.K_RIGHT]:
                    test_image.right_key_pressed = True

                if key[pygame.K_LEFT]:
                    test_image.left_key_pressed = True

                if key[pygame.K_UP]:
                    test_image.jump()


            if event.type == pygame.KEYUP:
                if event.key == pygame.K_RIGHT:
                    test_image.right_key_pressed = False
                if event.key == pygame.K_LEFT:
                    test_image.left_key_pressed = False
                if event.key == pygame.K_UP:
                    if test_image.jumping == True:
                        test_image.jumping = False
                        test_image.velocity.y *= -0.2

        test_image.update()
        test_image.draw(screen)
        pygame.display.update()





        # allows the user to quit the game
    pygame.quit()







home()
