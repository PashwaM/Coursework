def on_ground(arbiter, space, data):

#determining which arbiter object is the player feet
    if arbiter.shapes[0].collision_type == feet_collisions:
        feet = arbiter.shapes[0]
    else:
        feet = arbiter.shapes[1]

    player = feet.player
    player.count += 1
    player.ground = True
    return True

#function for flagging player in the air
def in_air(arbiter, space, data):

#determining which arbiter object is the player feet
    if arbiter.shapes[0].collision_type == feet_collisions:
        feet = arbiter.shapes[0]
    else:
        feet = arbiter.shapes[1]

    player = feet.player
    player.count -= 1
    if player.count < 1:
        player.count = 0
        player.ground = False
    return True

