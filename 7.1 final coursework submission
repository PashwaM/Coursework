#class for each fan spectator
class Fan:
    def __init__(self):

#setting constants inside constructor
        self.fan_num = random.randint(0, 4)
        self.image = fan_list[self.fan_num]
        self.x = random.randint(0, 650 - self.image.get_width())
        self.y = random.randint(0, 110 - self.image.get_height())
        self.rect = self.image.get_rect(topleft=(self.x, self.y))

#setting physics constants to allow jumping
        self.ground_pos = self.y
        self.velocity = 0
        self.gravity = 0.7
        self.ground = True
        self.position = float(self.y)

#handles upwards bobbing motion
    def vertical(self):

        #exact same code as my player vertical motion
        if self.velocity + self.gravity <= 12:
            self.velocity += self.gravity
        self.position += self.velocity - (self.gravity * .5)
        if self.position > self.ground_pos:
            self.ground = True
            self.velocity = 0
            self.position = float(self.ground_pos)
        self.rect.y = int(self.position)


#blits each fan onto the surface
    def draw(self):
        attempts  = 5000 #setting max attempts to prevent runtime error

        #validation to ensure no overlap between fans
        while any(self.rect.colliderect(fan.rect) for fan in fan_objects) == True and attempts > 0:
            self.x = random.randint(0, 650 - self.image.get_width())
            self.y = random.randint(0, 110 - self.image.get_height())
            self.rect = self.image.get_rect(topleft=(self.x, self.y))
            attempts -= 1

            self.ground_pos = self.y
            self.position = float(self.y)

#only adds fan if it found a suitable coordinate for it
        if attempts > 0:
            stadium.blit(self.image, self.rect)
            return True

#initiates the bobbing motion, same as the jump function for Player Class
    def fan_bobbing(self):
        if self.ground == True and random.random() <= 0.005:
            self.velocity -= 6
            self.ground = False #updates the flag

#general update function for fan class, called inside game loop
    def fan_update(self):
        self.fan_bobbing()
        self.vertical()


