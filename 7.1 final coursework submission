#class for all AI logic
class AI:
    def __init__(self, player):
        #constants
        self.player = player
        self.goal_x = 220
        self.goal_y = 400
        self.home = 270

    #updates the AI
    def update(self, ball):
        defend = False #flag for determining defending state
        #left and right keys default value are False
        self.player.left_key = False
        self.player.right_key = False
        #pythagoras' theorem
        ball_goal_distance = math.sqrt((ball.body.position.x - self.goal_x)**2 + (ball.body.position.y - self.goal_y)**2)
        if ball_goal_distance < 400:
            defend = True

        if defend == True:
            target_position = ball.body.position.x #AI moves to ball position
        else:
            target_position = self.home #AI moves to default home position

        target_distance = abs(target_position - self.player.body.position.x)
        #moves left and right based on target position
        if self.player.body.position.x < target_position and target_distance > 30: #preventing jittering
            self.player.right_key = True
        elif self.player.body.position.x > target_position and target_distance > 30:
            self.player.left_key = True

        #calculating distance between ball and foot
        foot_position_x = self.player.body.position.x + self.player.direction_foot * 30
        foot_position_y = self.player.body.position.y + 10
        #using pythagoras' theorem to get scalar distance
        if math.sqrt((ball.body.position.x - foot_position_x)**2 + (ball.body.position.y - foot_position_y)**2)  <= 70:
            #50/50 chance of high or low kick
            if random.random() < 0.5:
                self.player.first_kick()
                self.player.kicking_ball(ball, "high_kick")
            else:
                self.player.first_kick()
                self.player.kicking_ball(ball, "low_kick")

        #calculates horizontal and vertical distance between ball and player
        ball_player_distance_x = ball.body.position.x - self.player.body.position.x
        ball_player_distance_y = self.player.body.position.y - ball.body.position.y

        #validating the distance so only jumps within given ranges
        if 0 < ball_player_distance_x < 325 and 40 < ball_player_distance_y < 180:
            self.player.jump()

