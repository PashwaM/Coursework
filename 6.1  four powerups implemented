class Powerups():
    def __init__(self, ball):
        self.ball = ball
        self.powerup_start_time = 0
        self.duration = 6000
        self.cooldown = 5000
        self.activated = False
        self.next_spawn = 0
        self.spawned = False
        self.x = 0
        self.y = 0
        self.image = powerup_image
        self.rect = self.image.get_rect(center=(self.x, self.y))
        self.current_powerup = None
        self.player = None

    def player_collision(self):
        if recent_collision_time[0] > recent_collision_time[1]:
            if recent_ball_collision[0] == 1:
                self.player = player_objects[0]
            else:
                self.player = player_objects[1]
        else:
            if recent_ball_collision[1] == 1:
                self.player = player_objects[0]
            else:
                self.player = player_objects[1]


    def activate(self):
        self.powerup_start_time = pygame.time.get_ticks()
        self.activated = True
        self.current_powerup.start(self.player, self.ball)
        print("powerup activated")

    def deactivate(self):
        if self.activated == True:
            self.current_powerup.stop(self.player, self.ball)
        self.activated = False
        self.next_spawn = pygame.time.get_ticks() + self.cooldown + random.randint(0,2500)
        print('powerup deactivated')


    def spawn_powerup(self):
        self.x = random.randint(350,1140)
        self.y = random.randint( 205,380)
        self.current_powerup = powerup_list[random.randint(0,len(powerup_list)-1)]
        self.rect = self.image.get_rect(center=(self.x, self.y))
        self.spawned = True
        print("powerup spawned")

    def powerup_collision(self):
        if self.rect.colliderect(self.ball.rect):
            self.activate()
            self.spawned = False
            print("powerup collided")


    def update(self):
        self.player_collision()

        if self.spawned == True:
            screen.blit(self.image, self.rect)
            self.powerup_collision()

        if self.spawned == False and pygame.time.get_ticks() > self.next_spawn and self.activated != True:
            self.spawn_powerup()

        if pygame.time.get_ticks() - self.powerup_start_time >= self.duration and self.activated == True:
            self.deactivate()

    def reset(self):
        self.deactivate()
        print("powerup reset")




