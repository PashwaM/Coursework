class Ball:
    def __init__(self):

        self.image = football
        self.base_image = self.image
        self.rect = self.image.get_rect(center=(30,30))


        self.gravity = 500
        self.mass = 1.5
        self.radius = 30
        moment = pymunk.moment_for_circle(self.mass, 0, self.radius)

        self.body = pymunk.Body(self.mass, moment, body_type=pymunk.Body.DYNAMIC )
        self.body.position = (700, 530)
        self.body.damping = 1

        self.shape = pymunk.Circle(self.body, self.radius)
        self.shape.friction = 0.5
        self.shape.elasticity = 0.95
        self.shape.collision_type = ball_collisions

        space.add(self.body, self.shape)


        self.scored = False


    def draw(self, screen):

        pymunk.Body.update_velocity(self.body, (0, self.gravity), self.body.damping, 1/FPS)
        # Pymunk angle is radians; pygame rotation uses degrees and opposite sign
        degrees = -math.degrees(self.body.angle)
        # Rotate from the ORIGINAL each time (avoids blur
        self.image = pygame.transform.rotate(self.base_image, degrees)

        self.rect = self.image.get_rect(center=(int(self.body.position.x), int(self.body.position.y)))

        screen.blit(self.image, self.rect)

    def goal_check(self):
        center = (self.body.position.x, self.body.position.y)
        #pygame.draw.polygon(screen, (0, 255, 0), goal, 2)
        right_goal = pygame.Rect(1250,280,200,300)
        left_goal = pygame.Rect(0,280,250,300)
        if right_goal.collidepoint(center):
            if self.scored != True and is_goal(center, self.radius, right_goal_collision) == True:
                print("right goal")
                self.scored = True
                return True

        elif left_goal.collidepoint(center):
            if self.scored != True and is_goal(center, self.radius, left_goal_collision) == True:
                print("left goal")
                self.scored = True
                return True

        return False

    def reset(self):
        self.body.velocity = (0, 0)
        self.body.angular_velocity = 0
        self.body.position = (700, 530)
        self.rect = self.image.get_rect(center=(int(self.body.position.x), int(self.body.position.y)))




