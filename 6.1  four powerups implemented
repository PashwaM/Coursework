class Player_movement:
    def __init__(self, player, player_num):

        if player == "Ronaldo":
            self.image= Ronaldo_frames[0]
            self.frames = Ronaldo_frames.copy()
        elif player == "Messi":
            self.image= Messi_frames[0]
            self.frames = Messi_frames.copy()
        else:
            self.image= Mbappe_frames[0]
            self.frames = Mbappe_frames.copy()

        if player_num == 1:
            self.start_x, self.start_y = 1200, 545
        else:
            self.start_x, self.start_y = 300, 545
            for index in range(len(self.frames)):
                self.frames[index] = pygame.transform.flip(self.frames[index], 1, 0)
            self.image = self.frames[0]

        self.rect = self.image.get_rect(center=(self.start_x, self.start_y))
        self.left_key, self.right_key = False, False
        self.velocity = pygame.math.Vector2(0,0)
        self.acceleration = pygame.math.Vector2(0,0)
        self.acceleration_rate = 0.85
        self.friction = -0.045
        self.player_max_vel = 13

#pymunk constants
        self.mass = 13
        self.radius = 50
        moment = pymunk.moment_for_circle(self.mass, 0, self.radius)

        self.body = pymunk.Body(self.mass, moment, body_type=pymunk.Body.DYNAMIC )
        self.body.position = (self.start_x, self.start_y)
        self.body.damping = 0.99
        #self.body.moment = float("inf")
        self.body.moment = float("inf")
        self.body.angular_velocity = 0
        self.body.angle = 0
        if player_num == 1:
            self.shape = pymunk.Circle(self.body, self.radius, offset=(23, self.radius - 70))
            self.shape.collision_type = player1_collisions
            self.direction_foot = -1
        else:
            self.shape = pymunk.Circle(self.body, self.radius, offset=(-23, self.radius - 70))
            self.shape.collision_type = player2_collisions
            self.direction_foot = 1
        self.shape.friction = 0.05
        self.shape.elasticity = 0.2
        space.add(self.body, self.shape)

        self.max_ball_speed = 1300

#feet constants
        self.ground = False
        self.count = 0
        self.feet = pymunk.Circle(self.body, 12, offset=(0,self.radius) )
        self.feet.sensor = True
        self.feet.collision_type = feet_collisions
        self.feet.player = self
        space.add(self.feet)

#kick constants
        self.kicking = False
        self.frame_index = 0
        self.last_kick = 0
        self.kick_used = False

        self.frozen = False


    def horizontal(self):
        self.velocity.x = self.body.velocity.x / FPS
        self.acceleration.x = 0
        if self.left_key == True:
            self.acceleration.x -= self.acceleration_rate
        elif self.right_key == True:
            self.acceleration.x += self.acceleration_rate
        self.acceleration.x += self.velocity.x * self.friction
        self.velocity.x += self.acceleration.x
        self.limit_velocity(self.player_max_vel)
        self.body.velocity = (self.velocity.x * FPS, self.body.velocity.y)
        self.rect.center = int(self.body.position.x), int(self.body.position.y)

    def jump(self):
        if self.count > 0:
            self.body.apply_impulse_at_local_point((0,-(self.mass*12*FPS)))
            self.ground = False
            self.count = 0

    def limit_velocity(self, max_vel):
        self.velocity.x = max(-max_vel, min(self.velocity.x, max_vel))
        if abs(self.velocity.x) < 0.05:
            self.velocity.x = 0

    def kicking_ball(self, ball, type_of_kick):

        for ball in balls_list:
            foot_position_x = self.body.position.x + self.direction_foot * 30
            foot_position_y = self.body.position.y + 10


            distance_x =  ball.body.position.x - foot_position_x
            distance_y = (ball.body.position.y - foot_position_y) *-1

            if distance_x**2 + distance_y**2 <= 70**2 and (distance_x * self.direction_foot)>0 and self.kicking == True and self.kick_used == False:

                angle = math.degrees(math.atan2(distance_y, abs(distance_x)))
                if type_of_kick == "high_kick":
                    angle += 20

                if angle > 60:
                    angle = 60
                elif angle < 1:
                    angle = 1

                power = 2200
                angle_radians = math.radians(angle)

                impulse_x = math.cos(angle_radians) * power * self.direction_foot
                impulse_y = -math.sin(angle_radians) * power
                ball.body.apply_impulse_at_world_point((impulse_x, impulse_y), ball.body.position)

                recent_ball_collision[0] = self.shape.collision_type
                recent_collision_time[0] = pygame.time.get_ticks()

                ball_velocity_x, ball_velocity_y = ball.body.velocity
                speed = (ball_velocity_x**2 + ball_velocity_y**2) ** 0.5  # magnitude
                if speed > self.max_ball_speed:
                    velocity_scale = self.max_ball_speed / speed
                    ball.body.velocity = (ball_velocity_x * velocity_scale, ball_velocity_y * velocity_scale)


                self.kick_used = True

    def first_kick(self):
        if self.kicking != True:
            self.kicking = True
            self.frame_index = 0
            self.last_kick = pygame.time.get_ticks()
            self.image = self.frames[self.frame_index]
            self.kick_used = False

    def is_kicking(self):
        if self.kicking != True:
            return
        current_time = pygame.time.get_ticks()
        if current_time - self.last_kick >= 60:
            self.last_kick = current_time
            self.frame_index += 1

        if self.frame_index >= len(self.frames):
            self.frame_index = 0
            self.kicking = False
            self.image = self.frames[self.frame_index]
        else:
            self.image = self.frames[self.frame_index]

    def update(self):
            self.horizontal()
            self.is_kicking()

    def draw(self, screen):
        screen.blit(self.image, (self.rect.x, self.rect.y))

    def reset(self):
        self.body.velocity = (0,0)
        self.body.position = (int(self.start_x), int(self.start_y))
