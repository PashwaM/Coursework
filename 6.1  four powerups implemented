def on_ground(arbiter, space, data):

    if arbiter.shapes[0].collision_type == feet_collisions:
        feet = arbiter.shapes[0]
    else:
        feet = arbiter.shapes[1]


    player = feet.player
    player.count += 1
    player.ground = True
    return True


def in_air(arbiter, space, data):

    if arbiter.shapes[0].collision_type == feet_collisions:
        feet = arbiter.shapes[0]
    else:
        feet = arbiter.shapes[1]

    player = feet.player
    player.count -= 1
    if player.count < 1:
        player.count = 0
        player.ground = False
    return True

