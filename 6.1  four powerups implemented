def perpendicular_distance(ball_centre, vertex1, vertex2):

    ball_centre_x, ball_centre_y = ball_centre
    vertex1_x, vertex1_y = vertex1
    vertex2_x, vertex2_y = vertex2

    vertices_x = vertex2_x - vertex1_x
    vertices_y = vertex2_y - vertex1_y
    vertices_length = vertices_x**2 + vertices_y**2

    vertex1_ball_x = ball_centre_x - vertex1_x
    vertex1_ball_y = ball_centre_y - vertex1_y

    '''if vertices_length == 0:
        return math.hypot(vertex1_ball_x, vertex1_ball_y)'''


    t = (vertex1_ball_x * vertices_x + vertex1_ball_y * vertices_y) / vertices_length
    t = max(0, min(1, t))
    closest_x = vertex1_x + t * vertices_x
    closest_y = vertex1_y + t * vertices_y


    x_distance = ball_centre_x - closest_x
    y_distance = ball_centre_y - closest_y

    return math.sqrt(x_distance**2 + y_distance**2)


def is_goal(ball_center, radius, goal):

    for i in range(len(goal)-1):

        vertex1 = goal[i]
        vertex2 = goal[(i+1)]

        if perpendicular_distance(ball_center, vertex1, vertex2) < radius:
            return False

    return True


